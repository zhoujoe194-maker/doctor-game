"DepotBuild"
{
    "DepotID" "{{DEPOT_ID}}"
    "FileMapping"
    {
        "LocalPath" "*"
        "DepotPath" "."
        "Recursive" "1"
    }
    "FileExclusion" "*setup*.exe"
    "FileExclusion" "*uninstall*.exe"
    "FileExclusion" "*.blockmap"
    "FileExclusion" "*.pdb"
    "FileExclusion" "*.map"
    "FileExclusion" "*.pem"
    "FileExclusion" "*.key"
    "FileExclusion" "*.pfx"
    "FileExclusion" "*.p12"
    "FileExclusion" "*.webm"
    "FileExclusion" "*.mp4"
    "FileExclusion" "*.mkv"
    "FileExclusion" "*.log"
    "FileExclusion" ".env*"
    "FileExclusion" "*/.env*"
    "FileExclusion" "*.vdf"
    "FileExclusion" "node_modules/*"
    "FileExclusion" "*/node_modules/*"
    "FileExclusion" "recordings/*"
    "FileExclusion" "*/recordings/*"
    "FileExclusion" "installer/*"
    "FileExclusion" "tests/*"
    "FileExclusion" "scripts/*"
    "FileExclusion" "docs/*"
    "FileExclusion" ".git/*"
    "FileExclusion" ".agents/*"
}
